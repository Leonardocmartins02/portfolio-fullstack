# Banco de dados (SQLite local por padrao)
DATABASE_URL="file:./dev.db"

# Gere um valor aleatorio com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Credenciais do usuario admin criado pelo seed (prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="mudeesta123"

# Envio de notificacao por e-mail quando alguem preenche o formulario de contato.
# Usamos a API do Resend (https://resend.com) — SMTP de contas pessoais
# Outlook/Hotmail nao funciona mais (a Microsoft desativou a autenticacao basica).
# 1) Crie a conta gratuita, va em API Keys e gere uma chave (comeca com "re_").
# 2) Sem dominio proprio verificado, EMAIL_FROM precisa ser onboarding@resend.dev
#    e EMAIL_TO precisa ser o mesmo e-mail dono da conta Resend.
# Deixe em branco se nao quiser configurar agora: o formulario continua salvando
# as mensagens no banco, apenas nao envia a notificacao.
RESEND_API_KEY=""
EMAIL_FROM="Portfolio <onboarding@resend.dev>"
EMAIL_TO="seuemail@hotmail.com"
